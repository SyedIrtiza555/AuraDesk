{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions for Aura Desk",
  "windows": [
    "*"
  ],
  "permissions": [
    "core:default",
    "notification:default",
    "clipboard-manager:default",
    "process:default",
    "process:allow-restart",
    "updater:default",
    "oauth:allow-start",
    "oauth:allow-cancel",
    "opener:default"
  ]
}
