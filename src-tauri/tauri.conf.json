{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Aura Desk",
  "version": "1.0.0",
  "identifier": "com.aura.desk",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aura Desk",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "center": true,
        "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1NjI1NjNBNDVENENDMDcKUldRSHpOUkZPbFppZFFQN2xNOE5UU2Zzdkh4TFpkdXhjdEFybGJ5U0puL2s5anNYRDN2WHhlMU4K",
      "endpoints": [
        "https://github.com/SyedIrtiza555/AuraDesk/releases/latest/download/latest.json"
      ]
    }
  }
}
