rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Keep in sync with OWNER_EMAILS in src/shared/userProfile.ts
    function isOwnerEmail() {
      return request.auth != null
        && 'email' in request.auth.token
        && request.auth.token.email.lower() in ['s.irtizahussain@gmail.com'];
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasProfile() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Only active members get role permissions; pending/suspended users get none
    function hasRole(role) {
      return hasProfile() && myProfile().status == 'active' && myProfile().role == role;
    }

    function isOwner() {
      return isOwnerEmail() || hasRole('owner');
    }

    function isAdmin() {
      return isOwner() || hasRole('admin');
    }

    function isDesigner() {
      return hasRole('designer');
    }

    function isSalesAgent() {
      return hasRole('sales_agent');
    }

    function isActiveMember() {
      return isAdmin() || isDesigner() || isSalesAgent();
    }

    // Roles an admin may hand out or take away (never owner/admin)
    function isStaffRole(role) {
      return role in ['unassigned', 'sales_agent', 'designer'];
    }

    // ==========================================
    // 1. Users Collection
    // ==========================================
    match /users/{userId} {
      // Members see the team; anyone signed in can see their own profile (waiting room)
      allow read: if isActiveMember() || (isAuthenticated() && request.auth.uid == userId);

      // Self-registration always starts unassigned + pending, except the configured owner email
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && (
          (request.resource.data.role == 'unassigned' && request.resource.data.status == 'pending_approval')
          || (isOwnerEmail() && request.resource.data.role == 'owner' && request.resource.data.status == 'active')
        );

      allow update: if isOwner()
        // Admins manage staff only, and cannot promote to admin/owner
        || (isAdmin()
            && isStaffRole(resource.data.role)
            && isStaffRole(request.resource.data.role))
        // Everyone may edit their own non-privileged fields
        || (isAuthenticated()
            && request.auth.uid == userId
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'email', 'role', 'status', 'approvedAt', 'approvedBy']));

      // Owners remove members (revokes access); nobody can delete their own profile
      allow delete: if isOwner() && request.auth.uid != userId;
    }

    // ==========================================
    // 2. Orders Collection
    // ==========================================
    match /orders/{orderId} {
      allow read: if isAdmin() || isSalesAgent()
        || (isDesigner() && resource.data.assigned_designer_id == request.auth.uid);

      allow create: if isSalesAgent() || isAdmin();

      allow update: if isAdmin()
        || (isSalesAgent() && resource.data.sales_agent_id == request.auth.uid)
        || (isDesigner()
            && resource.data.assigned_designer_id == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['agreed_price', 'client_phone']));
      allow delete: if isOwner();
    }

    // ==========================================
    // 3. Invoices Collection
    // ==========================================
    match /invoices/{orderId} {
      allow read: if isAdmin() || isSalesAgent();
      allow create, update: if isAdmin();
      allow delete: if isOwner();
    }

    // ==========================================
    // 4. Order number counter (src/shared/orderNumbers.ts)
    // ==========================================
    match /counters/{counterId} {
      allow read: if isAdmin() || isSalesAgent();
      allow create: if (isAdmin() || isSalesAgent())
        && counterId == 'orders'
        && request.resource.data.keys().hasOnly(['next'])
        && request.resource.data.next is int;
      // Only ever moves forward, one reservation at a time
      allow update: if (isAdmin() || isSalesAgent())
        && request.resource.data.keys().hasOnly(['next'])
        && request.resource.data.next is int
        && request.resource.data.next > resource.data.next;
    }

    // ==========================================
    // 5. Order Snapshots (Time Machine)
    // ==========================================
    match /order_snapshots/{snapshotId} {
      allow read: if isActiveMember();
      allow create, update: if isActiveMember();
    }
  }
}
